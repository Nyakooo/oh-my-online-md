{
  "name": "oh-my-online-md-editor",
  "private": true,
  "scripts": {
    "build:icons": "node scripts/build-icons.mjs",
    "build": "node scripts/build-editor.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck:extension": "tsc -p extension/tsconfig.json",
    "test:browser": "node tests/run-browser.cjs",
    "test:extension": "pnpm build:extension && node tests/run-browser.cjs extension offline storage"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/markdown": "^1.4.0",
    "dompurify": "^3.4.17",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "esbuild": "^0.25.0",
    "playwright": "1.62.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
